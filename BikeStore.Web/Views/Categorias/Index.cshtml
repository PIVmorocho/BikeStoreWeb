@model List<BikeStore.Web.Models.Api.CategoriaDto>
@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Categorias</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva Categoria</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Activo</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Nombre</td>
                <td>@categoria.Descripcion</td>
                <td>
                    @if (categoria.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@categoria.IdCategoria" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@categoria.IdCategoria" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar la categoria @categoria.Nombre?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
