@{
    ViewData["Title"] = "Punto de Venta";
    var clientes = (List<BikeStore.Web.Models.Api.ClienteDto>)ViewBag.Clientes;
}

<h1>Punto de Venta</h1>

<form id="antiforgeryForm">@Html.AntiForgeryToken()</form>

<div class="row g-4">
    <div class="col-md-7">
        <div class="mb-3">
            <label class="form-label">Cliente</label>
            <select id="selCliente" class="form-select">
                <option value="">Seleccione un cliente</option>
                @foreach (var c in clientes)
                {
                    <option value="@c.IdCliente">@c.NombreCompleto — @c.Cedula</option>
                }
            </select>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-5">
                <input type="text" id="txtNombre" class="form-control" placeholder="Buscar por modelo..." />
            </div>
            <div class="col-md-5">
                <input type="text" id="txtMarca" class="form-control" placeholder="Buscar por marca..." />
            </div>
            <div class="col-md-2">
                <button type="button" id="btnBuscar" class="btn btn-outline-primary w-100">Buscar</button>
            </div>
        </div>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Bicicleta</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tblResultados"></tbody>
        </table>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Carrito</div>
            <div class="card-body">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Bicicleta</th>
                            <th>Cant.</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tblCarrito">
                        <tr id="filaCarritoVacio">
                            <td colspan="4" class="text-center text-muted">El carrito esta vacio</td>
                        </tr>
                    </tbody>
                </table>
                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span id="lblSubtotal">$0.00</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>IVA (15%)</span>
                    <span id="lblIva">$0.00</span>
                </div>
                <div class="d-flex justify-content-between fw-bold">
                    <span>Total</span>
                    <span id="lblTotal">$0.00</span>
                </div>
                <div id="mensajeVenta" class="mt-2"></div>
                <button type="button" id="btnRegistrar" class="btn btn-success w-100 mt-3">Registrar Venta</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const IVA_PORCENTAJE = 0.15;
        const carrito = [];

        function formatoMoneda(valor) {
            return valor.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        }

        function renderResultados(bicicletas) {
            const tbody = document.getElementById('tblResultados');
            tbody.innerHTML = '';
            bicicletas.forEach(b => {
                const tr = document.createElement('tr');
                const agotado = b.stock === 0;
                tr.innerHTML = `
                    <td>${b.marca} ${b.modelo}</td>
                    <td>${formatoMoneda(b.precio)}</td>
                    <td>${b.stock}</td>
                    <td><button type="button" class="btn btn-sm btn-primary" ${agotado ? 'disabled' : ''}>Agregar</button></td>
                `;
                tr.querySelector('button').addEventListener('click', () => agregarAlCarrito(b));
                tbody.appendChild(tr);
            });
        }

        function agregarAlCarrito(bicicleta) {
            const existente = carrito.find(i => i.idBicicleta === bicicleta.idBicicleta);
            const cantidadActual = existente ? existente.cantidad : 0;

            if (cantidadActual + 1 > bicicleta.stock) {
                mostrarMensaje('No hay suficiente stock disponible.', 'danger');
                return;
            }

            if (existente) {
                existente.cantidad += 1;
            } else {
                carrito.push({
                    idBicicleta: bicicleta.idBicicleta,
                    marca: bicicleta.marca,
                    modelo: bicicleta.modelo,
                    precio: bicicleta.precio,
                    stock: bicicleta.stock,
                    cantidad: 1
                });
            }
            renderCarrito();
        }

        function cambiarCantidad(idBicicleta, delta) {
            const item = carrito.find(i => i.idBicicleta === idBicicleta);
            if (!item) return;

            const nuevaCantidad = item.cantidad + delta;
            if (nuevaCantidad <= 0) {
                const index = carrito.indexOf(item);
                carrito.splice(index, 1);
            } else if (nuevaCantidad > item.stock) {
                mostrarMensaje('No hay suficiente stock disponible.', 'danger');
                return;
            } else {
                item.cantidad = nuevaCantidad;
            }
            renderCarrito();
        }

        function renderCarrito() {
            const tbody = document.getElementById('tblCarrito');
            tbody.innerHTML = '';

            if (carrito.length === 0) {
                tbody.innerHTML = '<tr id="filaCarritoVacio"><td colspan="4" class="text-center text-muted">El carrito esta vacio</td></tr>';
            } else {
                carrito.forEach(item => {
                    const subtotal = item.precio * item.cantidad;
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${item.marca} ${item.modelo}</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-menos">-</button>
                                <span class="btn btn-light disabled">${item.cantidad}</span>
                                <button type="button" class="btn btn-outline-secondary btn-mas">+</button>
                            </div>
                        </td>
                        <td>${formatoMoneda(subtotal)}</td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger btn-quitar">&times;</button></td>
                    `;
                    tr.querySelector('.btn-menos').addEventListener('click', () => cambiarCantidad(item.idBicicleta, -1));
                    tr.querySelector('.btn-mas').addEventListener('click', () => cambiarCantidad(item.idBicicleta, 1));
                    tr.querySelector('.btn-quitar').addEventListener('click', () => cambiarCantidad(item.idBicicleta, -item.cantidad));
                    tbody.appendChild(tr);
                });
            }

            const subtotalVenta = carrito.reduce((acc, i) => acc + (i.precio * i.cantidad), 0);
            const iva = subtotalVenta * IVA_PORCENTAJE;
            const total = subtotalVenta + iva;

            document.getElementById('lblSubtotal').textContent = formatoMoneda(subtotalVenta);
            document.getElementById('lblIva').textContent = formatoMoneda(iva);
            document.getElementById('lblTotal').textContent = formatoMoneda(total);
        }

        function mostrarMensaje(texto, tipo) {
            const div = document.getElementById('mensajeVenta');
            div.innerHTML = `<div class="alert alert-${tipo} py-2">${texto}</div>`;
        }

        document.getElementById('btnBuscar').addEventListener('click', async () => {
            const nombre = document.getElementById('txtNombre').value;
            const marca = document.getElementById('txtMarca').value;
            const params = new URLSearchParams({ nombre, marca });
            const response = await fetch(`/Ventas/BuscarBicicletas?${params.toString()}`);
            const bicicletas = await response.json();
            renderResultados(bicicletas);
        });

        document.getElementById('btnRegistrar').addEventListener('click', async () => {
            const idCliente = document.getElementById('selCliente').value;
            if (!idCliente) {
                mostrarMensaje('Seleccione un cliente antes de registrar la venta.', 'danger');
                return;
            }
            if (carrito.length === 0) {
                mostrarMensaje('Agregue al menos una bicicleta al carrito.', 'danger');
                return;
            }

            const token = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]').value;
            const payload = {
                idCliente: parseInt(idCliente, 10),
                detalles: carrito.map(i => ({ idBicicleta: i.idBicicleta, cantidad: i.cantidad }))
            };

            const response = await fetch('/Ventas/Registrar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': token
                },
                body: JSON.stringify(payload)
            });

            const resultado = await response.json();
            if (resultado.success) {
                window.location.href = `/Ventas/Detalle/${resultado.idVenta}`;
            } else {
                mostrarMensaje(resultado.error ?? 'No se pudo registrar la venta.', 'danger');
            }
        });
    </script>
}
