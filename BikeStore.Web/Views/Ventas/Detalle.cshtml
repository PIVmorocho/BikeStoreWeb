@model BikeStore.Web.Models.Api.VentaResponseDto
@{
    ViewData["Title"] = $"Venta #{Model.IdVenta}";
}

<h1>Venta #@Model.IdVenta</h1>

<dl class="row">
    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@Model.NombreCliente</dd>
</dl>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Bicicleta</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detalle in Model.Detalles)
        {
            <tr>
                <td>@detalle.Marca @detalle.Modelo</td>
                <td>@detalle.Cantidad</td>
                <td>@detalle.Precio.ToString("C")</td>
                <td>@detalle.Subtotal.ToString("C")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Subtotal</th>
            <th>@Model.Subtotal.ToString("C")</th>
        </tr>
        <tr>
            <th colspan="3" class="text-end">IVA (@((Model.PorcentajeIva * 100).ToString("0.##"))%)</th>
            <th>@Model.Iva.ToString("C")</th>
        </tr>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th>@Model.Total.ToString("C")</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-outline-secondary">Volver al Historial</a>
