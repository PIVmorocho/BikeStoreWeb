@model List<BikeStore.Web.Models.Api.VentaResponseDto>
@{
    ViewData["Title"] = "Historial de Ventas";
}

<h1>Historial de Ventas</h1>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Subtotal</th>
            <th>IVA</th>
            <th>Total</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var venta in Model)
        {
            <tr>
                <td>@venta.IdVenta</td>
                <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@venta.NombreCliente</td>
                <td>@venta.Subtotal.ToString("C")</td>
                <td>@venta.Iva.ToString("C")</td>
                <td>@venta.Total.ToString("C")</td>
                <td class="text-end">
                    <a asp-action="Detalle" asp-route-id="@venta.IdVenta" class="btn btn-sm btn-outline-primary">Ver Detalle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
