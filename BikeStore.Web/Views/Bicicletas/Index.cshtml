@using BikeStore.Web.Services
@model List<BikeStore.Web.Models.Api.BicicletaDto>
@{
    ViewData["Title"] = "Bicicletas";
    var categorias = (List<BikeStore.Web.Models.Api.CategoriaDto>)ViewBag.Categorias;
    var filtro = (BicicletaFiltro)ViewBag.Filtro;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bicicletas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva Bicicleta</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="nombre" value="@filtro.Nombre" class="form-control" placeholder="Buscar por modelo..." />
    </div>
    <div class="col-md-3">
        <select name="categoria" class="form-select">
            <option value="">Todas las categorias</option>
            @foreach (var c in categorias)
            {
                if (filtro.Categoria == c.IdCategoria)
                {
                    <option value="@c.IdCategoria" selected>@c.Nombre</option>
                }
                else
                {
                    <option value="@c.IdCategoria">@c.Nombre</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <input type="text" name="marca" value="@filtro.Marca" class="form-control" placeholder="Buscar por marca..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Categoria</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bici in Model)
        {
            <tr>
                <td>@bici.NombreCategoria</td>
                <td>@bici.Marca</td>
                <td>@bici.Modelo</td>
                <td>@bici.Precio.ToString("C")</td>
                <td>
                    @bici.Stock
                    @if (bici.Agotado)
                    {
                        <span class="badge bg-danger">Agotado</span>
                    }
                    else if (bici.StockBajo)
                    {
                        <span class="badge bg-warning text-dark">Stock bajo</span>
                    }
                </td>
                <td>@bici.Estado</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@bici.IdBicicleta" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@bici.IdBicicleta" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar @bici.Marca @bici.Modelo?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
