@model BikeStore.Web.Models.Api.BicicletaUpdateDto
@{
    ViewData["Title"] = "Editar Bicicleta";
    var bicicleta = (BikeStore.Web.Models.Api.BicicletaDto)ViewBag.Bicicleta;
}

<h1>Editar Bicicleta</h1>
<p class="text-muted">@bicicleta.NombreCategoria — @bicicleta.Marca @bicicleta.Modelo</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Edit" asp-route-id="@bicicleta.IdBicicleta" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" type="number" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
