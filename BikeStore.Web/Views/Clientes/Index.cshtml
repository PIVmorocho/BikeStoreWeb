@model List<BikeStore.Web.Models.Api.ClienteDto>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo Cliente</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Cedula</th>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Telefono</th>
            <th>Correo</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Cedula</td>
                <td>@cliente.Nombres</td>
                <td>@cliente.Apellidos</td>
                <td>@cliente.Telefono</td>
                <td>@cliente.Correo</td>
                <td class="text-end">
                    <a asp-controller="Ventas" asp-action="PorCliente" asp-route-idCliente="@cliente.IdCliente" class="btn btn-sm btn-outline-secondary">Historial</a>
                    <a asp-action="Edit" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@cliente.IdCliente" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar al cliente @cliente.Nombres @cliente.Apellidos?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
